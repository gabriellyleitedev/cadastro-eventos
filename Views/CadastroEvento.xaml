<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.Views.CadastroEvento"
             Style="{StaticResource Pagina}"
             Title="Cadastro de Evento">

    <ScrollView>
        <VerticalStackLayout Padding="24,32"
                             Spacing="20"
                             MaximumWidthRequest="720">

            <VerticalStackLayout Spacing="4">
                <Label Text="Novo evento" Style="{StaticResource Titulo}" />
                <Label Text="Preencha os dados abaixo para gerar o resumo do evento."
                       Style="{StaticResource Subtitulo}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Informações gerais" Style="{StaticResource TituloSecao}" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nome do evento" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource CampoBorda}">
                            <Entry x:Name="txt_nome"
                                   Style="{StaticResource Campo}"
                                   Placeholder="Ex.: Semana de Tecnologia" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Local do evento" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource CampoBorda}">
                            <Entry x:Name="txt_local"
                                   Style="{StaticResource Campo}"
                                   Placeholder="Ex.: Auditório da Etec" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Período" Style="{StaticResource TituloSecao}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Data de início" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource CampoBorda}">
                                <DatePicker x:Name="dtpck_inicio"
                                            Style="{StaticResource CampoData}"
                                            Format="dd/MM/yyyy"
                                            DateSelected="dtpck_inicio_DateSelected" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Data de término" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource CampoBorda}">
                                <DatePicker x:Name="dtpck_termino"
                                            Style="{StaticResource CampoData}"
                                            Format="dd/MM/yyyy" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Participação" Style="{StaticResource TituloSecao}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Participantes" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource CampoBorda}">
                                <Entry x:Name="txt_participantes"
                                       Style="{StaticResource Campo}"
                                       Keyboard="Numeric"
                                       Placeholder="Ex.: 120" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Custo por participante (R$)" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource CampoBorda}">
                                <Entry x:Name="txt_custo"
                                       Style="{StaticResource Campo}"
                                       Keyboard="Numeric"
                                       Placeholder="Ex.: 45,90" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Gerar resumo"
                    Style="{StaticResource BotaoPrincipal}"
                    Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
